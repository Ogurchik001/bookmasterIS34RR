<Page x:Class="bookmasterIS34RR.View.Pages.BrowseCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:bookmasterIS34RR.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1004" d:DesignWidth="1920"
  Title="Просмотр книг" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!--Панель поиска-->

        <Grid>
            <Grid.RowDefinitions>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
        </Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.ColumnSpan="3" Source="/Resources/logoo.png"/>
            <TextBlock Grid.Row="2" Text="Название:"/>
            <TextBox Grid.Row="2" Grid.Column="2"/>

            <TextBlock Grid.Row="4" Text="Авторы:"/>
            <TextBox Grid.Row="4" Grid.Column="2"/>

            <TextBlock Grid.Row="6" Text="Жанры:"/>
            <TextBox Grid.Row="6" Grid.Column="2"/>

            <Button Name="SearchBtn" Grid.Row="8" Grid.Column="2" Content="Поиск" Click="SearchBtn_Click"/>
            
            
        </Grid>
        
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="300" />
                <RowDefinition Height="10" />
                <RowDefinition Height="50" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="300" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <ListView Name="BookAuthorLv" Grid.Row="0" Grid.ColumnSpan="13" SelectionChanged="BookAuthorLv_SelectionChanged_1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="Авторы" DisplayMemberBinding="{Binding Authors}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Text="Страница" Grid.Row="2"/>
            <Button Name="PreviousPageBtn" Content="&lt;" Click="PreviousPageBtn_Click" Grid.Row="2" Grid.Column="2"/>

            <TextBox Name="CurrentPageTb" Grid.Column="4" FontSize="50" Grid.Row="2"/>

            <Button Name="NextPageBtn" Grid.Column="6" Content="&gt;" Grid.Row="2"/>

            <TextBlock Name="TotalPagesTbl" Grid.Column="8" Grid.Row="2" Text="из 4"/>
            <TextBlock Name="TotalBooksTbl" Grid.Column="10" Grid.ColumnSpan="3" Grid.Row="2" Text="{Binding ElementName=BookAuthorLv,Path=Items.Count, StringFormat={}{0} книг найдено}" HorizontalAlignment="Right"/>
            <Separator Grid.Row="3" Grid.ColumnSpan="11"/>
            <Grid Grid.Row="5" Grid.Column="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.ColumnSpan="3" Stretch="Fill" Source="/Resources/booklogo.jpg"/>

                <Button Grid.Row="2" Content="&lt;"/>
                <Button Grid.Row="2" Grid.Column="2" Content="&gt;"/>
            </Grid>
            <Grid Grid.Row="4" Grid.RowSpan="4" Grid.ColumnSpan="11">
                <Grid Name="BookDetailGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" Grid.Row="0" FontSize="30"/>
                    <TextBlock Text="{Binding Subtitle}" Grid.Row="2"/>

                    <TextBlock Grid.Row="4">
                        <Hyperlink Name="BookAuthorsDetailsHl" Click="BookAuthorsDetailsHl_Click">
                        <TextBlock Text="{Binding Authors}"/>
                    </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="{Binding FirstPublishDate, StringFormat={}Год первой публикации:{0:yyyy}}" Grid.Row="6" />
                    <TextBlock Text="" Grid.Row="6"/>
                    
                    <ScrollViewer Grid.Row="10" Padding="0 0 5 0">
                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
                    </ScrollViewer>
                    
                    <TextBlock Text="Описание" Grid.Row="8"/>
                    <TextBlock Text="Жанр" Grid.Row="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subjects}" Grid.Row="14"/>

                </Grid>
            </Grid>
   
            </Grid>
           
    </Grid>
    
</Page>
