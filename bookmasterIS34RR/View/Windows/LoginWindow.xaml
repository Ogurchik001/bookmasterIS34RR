<Window x:Class="bookmasterIS34RR.View.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bookmasterIS34RR.View.Windows"
        mc:Ignorable="d"
        Title="AuthorizationWindow" SizeToContent="Height" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="0 50" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="auto"/>
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="LoginTbl" Text="Логин" Grid.Row="0"/>
        <TextBox Name="LoginTb" Grid.Row="0" Grid.Column="2"/>
        
        <TextBlock Name="PasswordTbl" Text="Пароль" Grid.Row="2"/>
        <PasswordBox Name="PasswordPb" Grid.Row="2" Grid.Column="2" PasswordChar="*"/>
        
        <CheckBox Name="RememberMeCb" Grid.Row="4" Grid.Column="2" Content="Запомнить меня"/>
        <Grid Grid.Row="6" Grid.Column="2">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            
            <Button Name="LoginBtn" Content="Войти" Click="LoginBtn_Click"/>
            <Button Name="CancelBtn" Grid.Column="2" Content="Отмена" Click="CancelBtn_Click"/>
        </Grid>
    </Grid>
</Window>
